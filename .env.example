# Copy to .env.local and fill in. .env.local is git-ignored.
#
# Postgres connection string (Neon: use the *pooled* "-pooler" URL for the app).
# Leave unset to keep data in the browser only.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
#
# Optional: direct (non-pooler) URL for `npm run db:migrate`. If unset, the
# migration script derives it by removing "-pooler" from DATABASE_URL.
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
